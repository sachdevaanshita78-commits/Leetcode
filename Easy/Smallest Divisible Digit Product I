class Solution {
    public int smallestNumber(int n, int t) {
    
        for (int i=n;i<n+11;i++){
            int orig=i;
            int dig=i;
            int prod=1;
            while (dig>0){
                int rem=dig%10;
                prod*=rem;
                dig=dig/10;
            }
            if (prod%t==0)return orig;
        }
        return -1;
    }
}
