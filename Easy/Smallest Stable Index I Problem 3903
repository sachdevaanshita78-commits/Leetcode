class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int index=-1;
        int max=0;
        for (int i=0;i<nums.length;i++){
            if (max<nums[i])max=nums[i];
            int min=Integer.MAX_VALUE;
            for (int j=i;j<nums.length;j++){
                if (min>nums[j])min=nums[j];
            }
            if ((max-min)<=k){
                index=i;
                break;
            }

        }
        return index;
    }
}
