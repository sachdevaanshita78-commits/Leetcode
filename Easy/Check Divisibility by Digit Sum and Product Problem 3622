class Solution {
    public boolean checkDivisibility(int n) {
        int sum=0;
        int mult=1;
        int orig=n;
        while (n>0){
           int rem=n%10;
           sum=sum+rem;
           mult=mult*rem;
           n=n/10;
        } 
        int s=sum+mult;
        if (orig%s==0)return true;
        return false;
    }
}
