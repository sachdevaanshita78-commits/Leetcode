class Solution {
    public int missingInteger(int[] nums) {
        if (nums.length==1)return nums[0]+1;
        int sum=nums[0];
        int maxSum=sum;
        Set <Integer> mp=new HashSet<>();
        mp.add(nums[0]);
        boolean sumUpdation=true;
        for (int i=1;i<nums.length;i++){
            if (nums[i]==nums[i-1]+1 && sumUpdation){
                sum+=nums[i];

            }
            else{
                sumUpdation=false;
            }
            maxSum=Math.max(sum, maxSum);
            mp.add(nums[i]);
        }
        while (mp.contains(maxSum))maxSum++;
        return maxSum;
        
    }
}
