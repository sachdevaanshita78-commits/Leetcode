class Solution {
    public boolean canAliceWin(int n) {
        int count=0;
        // count=n/10;
        int num=n;
        int countn=10;
        for (int i=0;i<n;i++){
        	num=num-countn;
            if (num>=0) {
            	count++;
            }
            else {
            	break;
            }
            countn=countn-1;
            if (num<countn)break;
            // count++;
        }
        if (count%2==0)return false;
        return true;
    }
}
